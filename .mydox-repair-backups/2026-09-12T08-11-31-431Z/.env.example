# Browser-safe Supabase values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Server-only Supabase values
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# Optional push transport
PUSH_DISPATCH_SECRET=replace-with-long-random-secret
FCM_SERVICE_ACCOUNT_JSON=

# Optional AI gateway used by existing AI features
LOVABLE_API_KEY=

# Local-only diagnostic routes. Keep false in deployed environments.
VITE_ENABLE_DEV_TOOLS=false
