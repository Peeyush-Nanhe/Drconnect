{
  "name": "mydox-react-supabase",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cap:sync": "node scripts/android-preview.mjs",
    "cap:open:android": "cap open android",
    "android:sync-scaffold": "npm run android:prepare:preview",
    "android:prepare:preview": "node scripts/android-preview.mjs emulator",
    "android:apk:preview": "node scripts/android-preview.mjs emulator --build",
    "android:apk:usb": "node scripts/android-preview.mjs usb --build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:db && npm run build",
    "test:db": "node scripts/build-staging-baseline.mjs && node --test tests/database.test.mjs",
    "test:staging": "node --env-file=.env scripts/test-staging.mjs --run",
    "sync:status": "node scripts/github-sync.mjs status",
    "sync:pull": "node scripts/github-sync.mjs pull",
    "sync:push": "npm run check && node scripts/github-sync.mjs push",
    "test:ambulance": "node --experimental-strip-types --test tests/ambulance.test.mjs tests/ambulance-integration.test.mjs",
    "test:ambulance:db": "node --test tests/ambulance-database.test.mjs"
  },
